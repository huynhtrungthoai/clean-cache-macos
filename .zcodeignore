.build/
dist/
*.dmg
*.pkg
# Provisioning profiles carry the account App ID and team name; they are local/CI inputs, not source
*.provisionprofile
# Build products. The app name has changed before, so match *.app instead of hard-coding a name
build_app/*.app/
build_app/staging/
# The icon is generated by make_icon.swift; build.sh redraws it if missing, so it is not committed
build_app/AppIcon.icns
build_app/AppIcon.iconset/
# Fat binary produced by lipo when ARCH=universal, staged before going into the .app
build_app/DiskCleaner.universal
# productbuild output log; only its last line is shown when pkg signing fails
build_app/productbuild.log
# Local draft notes, not ready to publish; never committed
plans/
# Editor/agent working data inside the project; only meaningful on this machine
.workbuddy/
.DS_Store
build_app/derived/

# Signing material is never committed: private keys, certificates, CSRs, provisioning profiles (profiles carry the App ID prefix and team name)
*.p12
*.py12
*.cer
*.der
*.pem
*.key
*.csr
*.mobileprovision

# ===== ^ Everything above is synced from .gitignore ("Sync from .gitignore" rewrites only this part) =====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ^ Above are ZCode default exclusions (put custom rules below this line; sync/restore will not touch them) -----
